# Copy to .env and fill in. .env is gitignored; this file is committed (no secrets here).

# Defaults to the Postgres in compose.yaml (host port 15432) if unset.
DATABASE_URL=postgresql+asyncpg://searchdrift:searchdrift@localhost:15432/searchdrift

# Search vendors. Only needed for live runs; replay runs need no keys.
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=

# LLM providers (week 4).
GEMINI_API_KEY=
GROQ_API_KEY=
